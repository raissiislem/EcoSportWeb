{% extends '/reclamation_client/base.html.twig' %}

{% block title %}Nouvelle Réclamation{% endblock %}

{% block body %}
    {# templates/reclamation/new.html.twig #}

    <div class="reclamation-form-container">
        <h2>Nouvelle Réclamation</h2>

        {{ form_start(form,{'attr': {'novalidate': 'novalidate'}} ) }}
        <div class="form-group">
                {{ form_row(form.title) }}
            </div>
            <div class="form-group">
                {{ form_row(form.description) }}
            </div>
            <div class="form-group">
                {{ form_row(form.event) }}
            </div>
            <div class="form-group">
                {{ form_row(form.Ajouter) }}
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
