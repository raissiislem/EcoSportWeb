{% extends '/reclamation_client/base.html.twig' %}

{% block title %}Liste des Réclamations{% endblock %}

{% block body %}
<h1>Liste des Réclamations</h1>

<a href="{{ path('reclamation_new') }}" class="btn btn-primary mb-3">Ajouter une réclamation</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Description</th>
            <th>Evenement</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for reclamation in reclamations %}
            <tr>
                <td>{{ reclamation.title }}</td>
                <td>{{ reclamation.description|length > 50 ? reclamation.description[:50] ~ '...' : reclamation.description }}</td>
                <td>{{ reclamation.event.title }}</td>
                <td>
                    {% if reclamation.status == 'EN_COURS' %}
                        En cours
                    {% elseif reclamation.status == 'RESOLU' %}
                        Résolu
                    {% elseif reclamation.status == 'EN_ATTENTE' %}
                        En attente
                    {% else %}
                        {{ reclamation.status }}
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('reclamation_show_client', { id: reclamation.id }) }}" class="btn btn-info btn-sm">Voir</a>
                    <a href="{{ path('reclamation_edit', { id: reclamation.id }) }}" class="btn btn-warning btn-sm">Modifier</a>
                    <form method="post" action="{{ path('reclamation_delete_client', { id: reclamation.id }) }}" style="display:inline-block;" onsubmit="return confirm('Confirmer la suppression ?');">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
                        <button class="btn btn-danger btn-sm">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucune réclamation trouvée.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
