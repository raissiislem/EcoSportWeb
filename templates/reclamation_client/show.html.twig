{% extends '/reclamation_client/base.html.twig' %}

{% block title %}Détails Réclamation{% endblock %}

{% block body %}
    <div class="reclamation-form-container">
        <h2>Détails de la Réclamation</h2>

        <div class="form-group">
        <p><strong>Titre:</strong> {{ reclamation.title }}</p>
        </div>
        <div class="form-group">
        <p><strong>Description:</strong> {{ reclamation.description }}</p>
        </div>
        <div class="form-group">
        <p><strong>Status:</strong> {{ reclamation.status }}</p>
        </div>
        <div class="form-group">
            <p><strong>Réponse:</strong>
                {% if reclamation.response %}
                    {{ reclamation.response.content }}
                {% else %}
                    <em>Pas encore de réponse</em>
                {% endif %}
            </p>
        </div>

    </div>
{% endblock %}
